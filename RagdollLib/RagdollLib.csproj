<Project Sdk="Microsoft.NET.Sdk">
  <!-- Ragdoll physics library (working name). Holds the parts of CombatSimulator/Animation that do
       not depend on the game: no Dalamud SDK, FFXIVClientStructs, Lumina or ImGui here, and nothing
       from the plugin. The plugin references this project; the offline tests under Tests/ link these
       sources directly. See docs/REFACTOR_PLAN.md (track A). -->
  <PropertyGroup>
    <!-- BepuPhysics 2.5.0-beta.22 only targets net8.0, so that is the floor. -->
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>CombatSimulator.RagdollLib</AssemblyName>
    <!-- Not a NuGet identity (IsPackable is false). NuGet names a referenced project by PackageId,
         which defaults to the assembly name, while the SDK looks it up by project file name when it
         writes the plugin's deps.json. If the two differ, the DLL is listed there twice (once more as
         "CombatSimulator.RagdollLib.Reference"). Keep this equal to the project file name. -->
    <PackageId>RagdollLib</PackageId>
    <!-- Folders mirror the namespaces below CombatSimulator.Animation (as they did in the plugin). -->
    <RootNamespace>CombatSimulator.Animation</RootNamespace>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Same as the plugin (its SDK embeds symbols): stack traces in dalamud.log keep line numbers
         and no separate .pdb is copied next to the plugin or into its package. -->
    <DebugType>embedded</DebugType>
    <!-- The game hot-reloads the dev plugin only when CombatSimulator.dll itself is rewritten. With a
         reference assembly, a change inside a method body here would rebuild this DLL but leave the
         plugin DLL untouched, so nothing would reload. Without one, any change here recompiles the
         plugin as well (the Dalamud SDK sets the same for the plugin). -->
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <!-- Must stay the exact version the plugin references. -->
    <PackageReference Include="BepuPhysics" Version="2.5.0-beta.22" />
    <!-- The plugin (and the private module compiled into it) uses the internal types. -->
    <InternalsVisibleTo Include="CombatSimulator" />
  </ItemGroup>
</Project>
