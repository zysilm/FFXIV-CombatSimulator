<Project Sdk="Microsoft.NET.Sdk">
  <!-- Offline check of the automatic death shots (docs/DEATH_SHOTS.md): unit checks of the body frame and pose
       classes, and the metric run of every profile and both baselines over pose trajectories exported from the
       user's ragdoll recordings (the export mode of Tests/RagdollReplay; the trajectories stay in %TEMP%). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <!-- The plugin's death-shot code. Every file in that folder is game-free by rule, so this tool and the plugin
         run one solver. DynamicCameraSolver (pure as well) supplies the lens and projection. The fit of the
         Directed camera's old death framing, one of the two baselines, is OldDirectedFraming.cs here: the plugin
         dropped it when the automatic death shots replaced that framing. -->
    <Compile Include="../../CombatSimulator/Camera/DeathShots/*.cs" Link="Plugin/%(Filename)%(Extension)" />
    <Compile Include="../../CombatSimulator/Camera/DynamicCameraSolver.cs" Link="Plugin/DynamicCameraSolver.cs" />
  </ItemGroup>
</Project>
