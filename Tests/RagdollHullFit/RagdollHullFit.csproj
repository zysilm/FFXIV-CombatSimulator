    <Compile Include="../../AdvancedRagdoll/SkeletonProfiles/*.cs" Link="Production/SkeletonProfiles/%(Filename)%(Extension)" />
    <Compile Include="../../CombatSimulator/Animation/FfxivHumanoidProfile.cs" Link="Production/FfxivHumanoidProfile.cs" />
    <Compile Include="../../CombatSimulator/Animation/StructuralMeshSampler.cs" Link="Production/StructuralMeshSampler.cs" />
    <Compile Include="../../AdvancedRagdoll/RagdollTuning.cs" Link="Production/RagdollTuning.cs" />
    <Compile Include="../../AdvancedRagdoll/StructuralHullShape.cs" Link="Production/StructuralHullShape.cs" />
