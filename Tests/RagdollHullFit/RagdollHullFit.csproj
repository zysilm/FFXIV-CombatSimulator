  <ItemGroup>
    <PackageReference Include="Lumina" Version="7.6.0" />
    <PackageReference Include="BepuPhysics" Version="2.5.0-beta.22" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../../CombatSimulator/Animation/ModelGeometryData.cs" Link="Production/ModelGeometryData.cs" />
    <Compile Include="../../CombatSimulator/Animation/RenderedGeometryDecoder.cs" Link="Production/RenderedGeometryDecoder.cs" />
    <Compile Include="../../CombatSimulator/Animation/RenderedRaceDeformation.cs" Link="Production/RenderedRaceDeformation.cs" />
    <Compile Include="../../AdvancedRagdoll/StructuralMeshFitter.cs" Link="Production/StructuralMeshFitter.cs" />
