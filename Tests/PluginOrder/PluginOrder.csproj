<Project Sdk="Microsoft.NET.Sdk">
  <!-- Stage B7 (docs/REFACTOR_PLAN.md §4): proof that splitting Plugin.cs into feature modules kept the order of the
       constructor's build steps, the per-frame list and Dispose, and moved the plugin's methods verbatim. Syntax
       only (Roslyn), so it needs neither the game's assemblies nor the private module. Usage in Program.cs. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
  </ItemGroup>
</Project>
