<Project Sdk="Microsoft.NET.Sdk">
  <!-- Offline unit checks of the death replay's game-free parts (docs/DEATH_REPLAY.md §9): the ring buffer and the
       stretch a replay plays, the interpolation and the compact bone form, the shots stored relative to the body at
       death, the shot timing (equal split, loop cycling) and the free camera's step. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <!-- Every file in that folder is game-free by rule: the plugin and this tool run the same code. -->
    <Compile Include="../../CombatSimulator/Replay/Model/*.cs" Link="Plugin/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
