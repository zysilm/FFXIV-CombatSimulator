<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <!-- Keep warmed allocation/timing fixtures independent of tiered-JIT
         transitions. This affects this offline executable only. -->
    <RuntimeHostConfigurationOption Include="System.Runtime.TieredCompilation" Value="false" />
    <Compile Include="../../RagdollLib/Hair/FlexibleHairSolver.cs" Link="Production/FlexibleHairSolver.cs" />
    <Compile Include="../../RagdollLib/Hair/HairMeshEnvelope.cs" Link="Production/HairMeshEnvelope.cs" />
    <Compile Include="../../RagdollLib/Hair/HairMeshSample.cs" Link="Production/HairMeshSample.cs" />
    <Compile Include="../../RagdollLib/Hair/HairInputTiming.cs" Link="Production/HairInputTiming.cs" />
    <Compile Include="../../RagdollLib/MeshVolume/PosedSurfaceRegion.cs" Link="Production/PosedSurfaceRegion.cs" />
    <Compile Include="../../RagdollLib/MeshVolume/SurfaceSmoothing.cs" Link="Production/SurfaceSmoothing.cs" />
    <Compile Include="../../RagdollLib/MeshVolume/BodyMeshGeometry.cs" Link="Production/BodyMeshGeometry.cs" />
    <Compile Include="../../RagdollLib/MeshVolume/SurfaceMeshBvh.cs" Link="Production/SurfaceMeshBvh.cs" />
  </ItemGroup>
</Project>
