<Project Sdk="Microsoft.NET.Sdk">
  <!-- AdvancedRagdoll: the ragdoll physics library. Holds the ragdoll core (the Ragdoll class, stage A4) and the
       parts of the old CombatSimulator/Animation that do not depend on the game: no game SDK, game-structure bindings,
       game-data reader or UI library here, and nothing from the plugin; it references BepuPhysics only. The plugin references this
       project (its RagdollController is a thin shell over Ragdoll); the offline tests under Tests/ link these sources
       directly. See docs/REFACTOR_PLAN.md (track A) and docs/RAGDOLL_LIBRARY_ARCHITECTURE.md. Namespaces:
       AdvancedRagdoll.* (stage A4). The public API (stage A7) is the Ragdoll constructor on AdvancedRagdoll.Hosting.RagdollHost,
       and the skeleton profile types; everything else is internal (the AdvancedRagdoll.Bepu extension points too, for 0.1). -->
  <PropertyGroup>
    <!-- BepuPhysics 2.5.0-beta.22 only targets net8.0, so that is the floor. -->
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>AdvancedRagdoll</AssemblyName>
    <!-- The NuGet identity. NuGet names a referenced project by PackageId, while the SDK looks it up by
         project file name when it writes the plugin's deps.json. If the two differ, the DLL is listed
         there twice (once more as "AdvancedRagdoll.Reference"). Keep this equal to the project file name. -->
    <PackageId>AdvancedRagdoll</PackageId>
    <!-- Folders mirror the namespaces below AdvancedRagdoll. -->
    <RootNamespace>AdvancedRagdoll</RootNamespace>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Same as the plugin (its SDK embeds symbols): stack traces in the host's log keep line numbers
         and no separate .pdb is copied next to the plugin or into its package. -->
    <DebugType>embedded</DebugType>
    <!-- The game hot-reloads the dev plugin only when CombatSimulator.dll itself is rewritten. With a
         reference assembly, a change inside a method body here would rebuild this DLL but leave the
         plugin DLL untouched, so nothing would reload. Without one, any change here recompiles the
         plugin as well (the plugin's SDK sets the same for the plugin). -->
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
  </PropertyGroup>
  <!-- The NuGet package (stage A7). `dotnet pack -c Release -o <dir>` builds it; nothing here publishes it (the release
       workflow uses NuGet Trusted Publishing, docs/PROJECT_LOG.md §2). The plugin and the tests build the project the
       same way with or without these. -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Version>0.1.0-beta.1</Version>
    <Authors>zysilm</Authors>
    <Description>Ragdoll physics for .NET games on BepuPhysics: builds a ragdoll from a character's skeleton (a hand-tuned humanoid profile, or a rig generated from any skeleton), takes over from the death animation at a chosen moment, lands on the game's ground and water, and writes the pose back. Not thread-safe per ragdoll; one BepuPhysics simulation per ragdoll.</Description>
    <PackageTags>ragdoll;physics;bepuphysics;animation;games</PackageTags>
    <PackageLicenseExpression>MPL-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/zysilm/AdvancedRagdoll</PackageProjectUrl>
    <RepositoryUrl>https://github.com/zysilm/AdvancedRagdoll</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- Source Link (built into the .NET SDK) maps the embedded PDB to the commit and repository the package is built
         from; generated sources are embedded. -->
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <!-- Must stay the exact version the plugin references; pinned exactly ([x]) so the package does not float to a
         later BepuPhysics beta. -->
    <PackageReference Include="BepuPhysics" Version="[2.5.0-beta.22]" />
    <!-- The plugin (and the private module compiled into it) uses the internal types. -->
    <InternalsVisibleTo Include="CombatSimulator" />
    <!-- The offline replay (Tests/RagdollReplay) hands recorded fit results back to the controller. -->
    <InternalsVisibleTo Include="RagdollReplay" />
  </ItemGroup>
</Project>
