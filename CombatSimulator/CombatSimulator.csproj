<Project Sdk="Dalamud.NET.Sdk/15.0.0" TreatAsLocalProperty="DefineConstants">
  <PropertyGroup>
    <Version>3.0.0.0</Version>
    <Authors>zysilm</Authors>
    <Description>A combat sandbox that makes FFXIV feel more like an action RPG, with responsive fights and advanced ragdoll physics.</Description>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- Experimental dev module: a private git submodule at Dev/Experimental. When it is checked out
       its sources compile in and DEV_EXPERIMENTAL is defined; otherwise the SDK glob finds none of
       those files and the plugin builds against the no-op DevExperimentalStub. The public CI builds
       without the submodule; public releases always exclude it. -->
  <PropertyGroup Condition="Exists('$(MSBuildProjectDirectory)\Dev\Experimental\DevExperimentalModule.cs') and !$([System.String]::Copy('$(DefineConstants)').Contains('PUBLIC_BUILD'))">
    <DefineConstants>$(DefineConstants);DEV_EXPERIMENTAL</DefineConstants>
  </PropertyGroup>
  <!-- A local public verification may run while the private submodule is physically present.
       Remove its sources explicitly so that build cannot produce a hybrid DLL with the Dev UI
       compiled in but Plugin.cs selecting DevExperimentalStub. -->
  <ItemGroup Condition="$([System.String]::Copy('$(DefineConstants)').Contains('PUBLIC_BUILD'))">
    <Compile Remove="Dev\Experimental\**\*.cs" />
    <EmbeddedResource Remove="Dev\Experimental\**\*" />
    <Content Remove="Dev\Experimental\**\*" />
    <None Remove="Dev\Experimental\**\*" />
  </ItemGroup>
  <!-- Private experimental data assets, embedded only when the dev submodule is present and this is
       not a public build. The public DLL never contains them. -->
  <ItemGroup Condition="Exists('$(MSBuildProjectDirectory)\Dev\Experimental\DevExperimentalModule.cs') and !$([System.String]::Copy('$(DefineConstants)').Contains('PUBLIC_BUILD'))">
    <EmbeddedResource Include="Dev\Experimental\Assets\*.dat" />
    <EmbeddedResource Include="Dev\Experimental\Resources\**\*.json" />
  </ItemGroup>
  <ItemGroup>
    <!-- Nested standalone tests and their generated obj sources are not plugin sources. -->
    <Compile Remove="**\Tests\**\*.cs" />
    <PackageReference Include="BepuPhysics" Version="2.5.0-beta.22" />
    <PackageReference Include="DotRecast.Core" Version="2026.3.1" />
    <PackageReference Include="DotRecast.Recast" Version="2026.3.1" />
    <PackageReference Include="DotRecast.Detour" Version="2026.3.1" />
    <PackageReference Include="DotRecast.Detour.Crowd" Version="2026.3.1" />
    <PackageReference Include="Silk.NET.Direct3D11" Version="2.21.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- AdvancedRagdoll, the game-independent ragdoll physics library, from nuget.org. It has its own repository
         (https://github.com/zysilm/AdvancedRagdoll); how library changes reach the plugin: CLAUDE.md. NuGet takes the
         lowest matching version and packages.lock.json pins it. Like every package dependency, its DLL is copied next
         to the plugin DLL and into the packaged zip. -->
    <PackageReference Include="AdvancedRagdoll" Version="0.1.0-beta.2" />
  </ItemGroup>
  <ItemGroup>
    <!-- The offline replay (Tests/RagdollReplay) drives RagdollController through its internal host constructor. -->
    <InternalsVisibleTo Include="RagdollReplay" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Npcs\NpcNames.json" />
    <EmbeddedResource Include="Npcs\Data\BNpcLinkNoGubal.csv" />
    <EmbeddedResource Include="Npcs\Data\LuminaSupplemental.LICENSE" />
    <EmbeddedResource Include="Resources\CharacterSurfaceProfiles.json" />
    <EmbeddedResource Include="Resources\CollapseProfiles\*.json" />
    <EmbeddedResource Include="Resources\CombatRecipes\*.json" />
    <EmbeddedResource Include="Resources\Actions.json" />
    <EmbeddedResource Include="UpdateLog\update-log.json" />
    <EmbeddedResource Include="Resources\gaya_nosound.scd" />
    <EmbeddedResource Include="Resources\VoiceEntryLabels.json" />
    <EmbeddedResource Include="Resources\VoiceLines.json" />
    <EmbeddedResource Include="Resources\VoicePersonas.json" />
    <!-- Curated cutscene follow shots: references and derived features only (docs/CUTSCENE_SHOTS.md). -->
    <EmbeddedResource Include="Resources\CutsceneShots.json" />
  </ItemGroup>
</Project>
